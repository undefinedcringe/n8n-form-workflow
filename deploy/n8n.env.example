# Recommended n8n server settings for this workflow. Contains no secrets.

# Hides stack traces in n8n's own error replies.
NODE_ENV=production

# Rejects oversized requests before they reach the workflow. Values are in MiB.
N8N_PAYLOAD_SIZE_MAX=1
N8N_FORMDATA_FILE_SIZE_MAX=1

# Stops workflow code and expressions from reading server environment variables.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Failed runs hold submitted data for recovery. Delete them after 14 days (336 hours).
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
